{
  "manifest_version": 3,
  "name": "StateJS Designer",
  "version": "0.1",
  "description": "Manipulate document.state in real-time.",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": ["activeTab", "scripting", "sidePanel", "tabs"],
  "host_permissions": [
    "http://localhost/*",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"], 
      "js": ["content_script.js"],
      "run_at": "document_start"
    }
  ],
  "side_panel": { "default_path": "popup.html" }
}