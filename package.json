{
  "name": "@rivierasolutions/state.js",
  "version": "1.0.4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rivierasolutions/state.js.git"
  },
  "description": "A Passive View MVC framework for modern web applications.",
  "main": "dist/state.min.js",
  "module": "dist/state.esm.js",
  "keywords": [
    "mvc",
    "framework",
    "passive-view",
    "view-state",
    "state-management",
    "html-contract"
  ],
  "files": [
    "dist/",
    "types/",
    "README.md",
    "LICENSE.txt"
  ],
  "author": "Piotr Wójcik",
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.27.2",
    "local-web-server": "^5.4.0"
  },
  "scripts": {
    "serve": "ws --port 5500 --rewrite '/examples/statejs-router((?!/views/|/controllers\\.js).*) -> /examples/statejs-router/index.html'",
    "build": "npm run build-min && npm run build-esm && npm run build-router-min && npm run build-router-esm",
    "build-min": "esbuild src/state.js --bundle --minify --sourcemap --outfile=dist/state.min.js",
    "build-esm": "esbuild src/state.js --bundle --format=esm --outfile=dist/state.esm.js",
    "build-router-min": "esbuild router/state-router.js --bundle --minify --sourcemap --outfile=dist/state-router.min.js",
    "build-router-esm": "esbuild router/state-router.js --bundle --format=esm --outfile=dist/state-router.esm.js"
  }
}
